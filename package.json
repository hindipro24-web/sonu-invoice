{
  "name": "smart-parts-billing",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:android": "CAPACITOR_BUILD=true vite build",
    "preview": "vite preview",
    "android:sync": "npm run build:android && cap sync android",
    "android:assets": "capacitor-assets generate --android",
    "android:apk": "npm run android:sync && cd android && chmod +x gradlew && ./gradlew assembleDebug",
    "android:open": "npm run android:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "framer-motion": "^11.11.17",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
